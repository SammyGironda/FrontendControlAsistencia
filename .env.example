# ============================================================
# RRHH Bolivia MVP — Frontend — Plantilla de variables de entorno
# Copiar como .env y ajustar los valores. El .env real NUNCA sube a Git.
# ============================================================

# URL base de la API backend (FastAPI). Sin barra final.
VITE_API_URL=http://localhost:8000

# ── Modo de desarrollo sin autenticación real ──────────────────
# true  = al arrancar, la app inicia sesión automáticamente contra el
#         backend real (POST /api/v1/auth/login) usando las credenciales de
#         VITE_BYPASS_USERNAME/VITE_BYPASS_PASSWORD de abajo. Obtiene un JWT
#         real, no un token simulado — útil para desarrollar pantallas sin
#         tener que loguearse a mano en cada recarga, pero sigue exigiendo
#         que el backend esté corriendo y que esas credenciales existan.
# false = no hace auto-login; usa el login real vía el formulario
#         (POST /api/v1/auth/login, JWT).
#
# IMPORTANTE: nunca dejar en "true" en producción.
VITE_BYPASS_AUTH=false

# Usuario/contraseña reales del backend usados SOLO cuando
# VITE_BYPASS_AUTH=true. Deben existir en la base y tener el rol que
# necesites probar (admin/rrhh/supervisor, no "Empleado" si vas a probar
# pantallas privilegiadas). Si faltan o son incorrectos, la app muestra una
# pantalla de error con botón "Reintentar" en vez de arrancar rota.
VITE_BYPASS_USERNAME=
VITE_BYPASS_PASSWORD=
