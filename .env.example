# ============================================================
# RRHH Bolivia MVP — Frontend — Plantilla de variables de entorno
# Copiar como .env y ajustar los valores. El .env real NUNCA sube a Git.
# ============================================================

# URL base de la API backend (FastAPI). Sin barra final.
VITE_API_URL=http://localhost:8000

# ── Modo de desarrollo sin autenticación real ──────────────────
# true  = omite el login real: la app arranca ya autenticada con un usuario
#         de prueba (ver Frontend/src/store/authStore.js y src/api/auth.js).
#         Útil para desarrollar pantallas sin depender del backend de auth.
# false = usa el login real contra POST /api/v1/auth/login (JWT).
#         Requiere que el backend esté corriendo y accesible en VITE_API_URL.
#
# IMPORTANTE: nunca dejar en "true" en producción.
VITE_BYPASS_AUTH=false
